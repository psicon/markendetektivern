diff --git a/node_modules/react-native-document-scanner-plugin/ios/DocScanner/DocScanner.swift b/node_modules/react-native-document-scanner-plugin/ios/DocScanner/DocScanner.swift
index 251c633..3baa97f 100644
--- a/node_modules/react-native-document-scanner-plugin/ios/DocScanner/DocScanner.swift
+++ b/node_modules/react-native-document-scanner-plugin/ios/DocScanner/DocScanner.swift
@@ -77,6 +77,13 @@ public class DocScanner: NSObject, VNDocumentCameraViewControllerDelegate {
             // launch the document scanner
             let documentCameraViewController = VNDocumentCameraViewController()
             documentCameraViewController.delegate = self
+            // PATCH (markendetektive): Auto-Shutter ausschalten via
+            // undokumentierte KVC-Property `autoScansEnabled`. Apple
+            // exposed kein public Toggle, aber das interne BOOL-Property
+            // ist seit iOS 13 settable. Falls Apple's Property-Name in
+            // einer zukünftigen iOS-Version sich ändert: setValue ist
+            // no-op (kein Crash, Auto-Capture bleibt dann active).
+            documentCameraViewController.setValue(false, forKey: "autoScansEnabled")
             self.viewController?.present(documentCameraViewController, animated: true)
         }
     }
