rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
// MarkenDetektive — Firestore Security Rules (Stufe-0-Härtung, 2026-07)
//
// Prinzipien (ClickUp 86cahgwmn, Stufe 0):
//  • WHITELIST: alles Ungematchte fällt in den finalen deny-all.
//  • GENAU EIN /users-Block (die alten 5 überlappenden Blöcke wurden per
//    OR vereinigt — der lockerste gewann, jede Validierung war wirkungslos).
//  • GELD IST SERVER-ONLY: cashback_balance/lifetime/counter-Felder und
//    users/*/cashback_ledger sind client-seitig NICHT schreibbar. Cloud
//    Functions nutzen das Admin-SDK und umgehen Rules — nichts bricht.
//  • Öffentlicher Katalog bleibt read:true (Boot-Reads laufen teils vor
//    abgeschlossenem Anonymous-Sign-In — kein Auth-Race einbauen).
//  • Client-Nutzungs-Census 2026-07-02: jede hier erlaubte Operation hat
//    eine nachgewiesene Callsite in lib/app/components; alles andere wurde
//    bewusst gesperrt (Legacy: FlutterFlow-/MDM-/Scraper-Reste).
// ─────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // Geld-Felder auf users/{uid} — schreibt AUSSCHLIESSLICH der Server
    // (cashback-pipeline syncLedger/requestPayout/refund, survey-reward).
    function touchesMoneyFields(keys) {
      return keys.hasAny([
        'cashback_balance_cents',
        'cashback_lifetime_cents',
        'cashback_monthly',
        'cashback_campaign_weekly',
        'cashback_campaign_totals',
        'cashback_last_bon_date'
      ]);
    }

    // ── Öffentlicher Katalog (read-only für Clients) ─────────────────
    // Client-Writes laufen für ALLE diese Collections über Cloud
    // Functions/Pipelines (Admin-SDK). `update: if true` auf produkte/
    // markenProdukte (jeder konnte den Katalog ändern!) ist entfernt.
    match /produkte/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /markenProdukte/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /hersteller/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /hersteller_new/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /handelsmarken/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /kategorien/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /discounter/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /packungstypen/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if false;
    }
    match /external_products/{ean} {
      allow read: if true;
      allow write: if false;
    }
    // Nutrition-Quellen (App liest Nährwerte/Zutaten; Pipelines schreiben).
    match /reweapify/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /nutritionscrape/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /scraped_products/{document} {
      allow read: if true;
      allow write: if false;
    }
    // Aggregate (Bestenlisten-Snapshot, B2B) — nur CF schreibt.
    match /aggregates/{document} {
      allow read: if true;
      allow write: if false;
    }
    // Achievement-Katalog (öffentliche Definitionen).
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if false;
    }
    // Gamification-Konfiguration (actions/streaks/levels/items…).
    match /gamification/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Cashback / Kassenbon-System ──────────────────────────────────
    match /cashback_config/{configId} {
      allow read: if true;
      allow write: if false;
    }
    match /cashback_campaigns/{campaignId} {
      allow read: if true;
      allow write: if false;
    }
    // Eigene Bons + Auszahlungen lesbar, keine Client-Writes.
    match /receipts/{receiptId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /cashback_payouts/{payoutId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /cashback_review_queue/{queueId} {
      allow read: if false;
      allow write: if false;
    }
    match /cashback_consumption/{month} {
      allow read: if false;
      allow write: if false;
    }

    // Produkt-Foto Crowd-Uploads — User legt eigene Pending-Einträge an
    // + liest sie; Review/Vergütung läuft serverseitig.
    match /crowd_uploads/{uploadId} {
      allow create: if signedIn()
                     && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Umfragen (RevealyIQ) ─────────────────────────────────────────
    // polls schreibt NUR das Admin-Tool (Admin-SDK); rewardCents ist der
    // Auszahlungsbetrag der survey-reward-CF → niemals client-schreibbar.
    match /polls/{document} {
      allow read: if true;
      allow write: if false;
    }
    // Antworten: nur eigene anlegen + lesen (App prüft "schon beantwortet"
    // via where('userId','==',uid)). Auswertung serverseitig.
    match /poll_responses/{document} {
      allow create: if signedIn()
                     && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Bestenliste ──────────────────────────────────────────────────
    // leaderboardService.updateUserStats schreibt das EIGENE Doc client-
    // seitig (weekly/monthly-Counter); Woche/Monat-Listen sind eine echte
    // Client-Query über die Collection → read für eingeloggte User.
    // Vorher: read+write für JEDEN ohne Auth (Rang-Fälschung + PII-Scrape).
    match /leaderboards/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Produkt-Bewertungen (top-level, Owner-Feld `userID`) ─────────
    match /productRatings/{ratingId} {
      allow read: if true;
      allow create: if signedIn()
                     && request.resource.data.userID == request.auth.uid;
      allow update, delete: if signedIn()
                     && resource.data.userID == request.auth.uid;
    }

    // ── App-Feedback (Rating-Prompt) — eigene Docs, Owner-Feld `userId` ──
    match /userfeedback/{document} {
      allow create: if signedIn()
                     && request.resource.data.userId == request.auth.uid;
      allow read, update: if signedIn()
                     && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Onboarding-Analytics (write-only Telemetrie, Session-ID-Docs) ──
    match /onboardingResultsV5/{sessionId} {
      allow create, update: if signedIn();
      allow read, delete: if false;
    }

    // ── Push-Token-Registry (Admin-Broadcasts; Doc-ID = Token) ───────
    match /pushTokens/{token} {
      allow create, update: if signedIn()
                     && request.resource.data.userId == request.auth.uid;
      allow read, delete: if false;
    }

    // ── User-Daten ───────────────────────────────────────────────────
    // GENAU EIN Block. Owner-only; Geld-Felder sind ausgenommen (server-
    // only). Der Client schreibt legitim: Profil, stats.*, cashback_consent,
    // pushToken, Onboarding-Flags, Settings … (Census 2026-07-02: keine
    // einzige legitime Client-Write-Stelle für die Geld-Felder).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                     && !touchesMoneyFields(request.resource.data.keys());
      allow update: if isOwner(userId)
                     && !touchesMoneyFields(
                          request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;

      // Owner-verwaltete Subcollections (nachgewiesene Client-Writes).
      match /einkaufswagen/{document} {
        allow read, create, update, delete: if isOwner(userId);
      }
      match /favorites/{document} {
        allow read, create, update, delete: if isOwner(userId);
      }
      match /journeys/{document} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false; // Cleanup läuft serverseitig (journey-cleanup)
      }
      match /purchases/{document} {
        allow read, create, update, delete: if isOwner(userId);
      }
      match /scanHistory/{document} {
        allow read, create, update, delete: if isOwner(userId);
      }
      match /searchHistory/{document} {
        allow read, create, update, delete: if isOwner(userId);
      }
      match /stats/{document} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }
      match /fcmTokens/{token} {
        allow read, create, update, delete: if isOwner(userId);
      }
      // Bon-Status-Mirror: Client legt Placeholder an ('uploading') und
      // merged Updates; die Pipeline (Admin-SDK) schreibt den Rest.
      match /cashback_status/{document} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }
      // Punkte-Ledger: append-only vom Owner, Shape-validiert (alle drei
      // Client-Write-Stellen schreiben {action, points, timestamp, …}).
      // Punkte sind KEIN Geld — Geld liegt in cashback_ledger (server-only).
      match /ledger/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['action', 'points', 'timestamp'])
          && request.resource.data.action is string
          && request.resource.data.points is number
          && request.resource.data.points >= 0
          && request.resource.data.points <= 10000
          && request.resource.data.timestamp is timestamp;
        allow update, delete: if false;
      }
      // GELD-Ledger + OCR-Artikel-Trail: NUR Cloud Functions schreiben.
      match /cashback_ledger/{document} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /purchased_products/{document} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      // Fallback für alle übrigen/künftigen Subcollections: Owner darf
      // lesen, schreiben darf nur der Server. (Explizite Blöcke oben
      // erweitern das per OR — neue Subcollections sind damit safe-by-
      // default und brauchen einen bewussten Rules-Eintrag für Writes.)
      match /{subcollection}/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ── Geteilte Einkaufszettel (Stufe 5) ────────────────────────────
    // Top-Level-Container. Der PERSÖNLICHE Zettel (users/*/einkaufswagen)
    // bleibt unberührt — das hier ist additiv.
    // Sicherheits-Kern (Lektion aus Stufe 0): `memberIds` darf client-seitig
    // NIE ERWEITERT werden. Beitritt läuft AUSSCHLIESSLICH über die Cloud
    // Function joinSharedList (Admin-SDK, umgeht Rules) — sonst lädt man sich
    // selbst in fremde Listen ein. Clients dürfen memberIds nur SCHRUMPFEN.
    match /shared_lists/{listId} {
      // Lesen: nur wer Mitglied ist.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Anlegen: der Owner, mit sich als ownerId UND genau sich als einzigem
      // Mitglied (verhindert das Anlegen einer Liste mit Fremden).
      allow create: if signedIn()
                     && request.resource.data.ownerId == request.auth.uid
                     && request.resource.data.memberIds is list
                     && request.resource.data.memberIds.size() == 1
                     && request.resource.data.memberIds[0] == request.auth.uid;

      // Ändern: ownerId unveränderlich; memberIds darf NIE wachsen (neue Menge
      // ⊆ alte Menge). Owner darf umbenennen + Mitglieder entfernen; ein
      // Nicht-Owner-Mitglied darf NUR sich selbst entfernen (Liste verlassen).
      allow update: if signedIn()
                     && request.auth.uid in resource.data.memberIds
                     && request.resource.data.ownerId == resource.data.ownerId
                     && request.resource.data.memberIds.toSet()
                          .difference(resource.data.memberIds.toSet()).size() == 0
                     && (
                          resource.data.ownerId == request.auth.uid
                          || resource.data.memberIds.toSet()
                               .difference(request.resource.data.memberIds.toSet())
                               == [request.auth.uid].toSet()
                        );

      // Löschen: nur der Owner.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Items der Liste: lesen/schreiben nur Mitglieder (get() auf die Parent-
      // Liste). Gleiche Item-Form wie der persönliche Zettel + `addedBy`.
      match /items/{itemId} {
        allow read, write: if signedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/shared_lists/$(listId)).data.memberIds;
      }
    }

    // ── Finaler deny-all ─────────────────────────────────────────────
    // Alles Ungematchte (inkl. der früher offenen Legacy-Collections:
    // FlutterFlow-Backdoor, MDM/master_*, *_aliases, mdm_*, scraper-
    // Write-Zugriffe, onboarding*-Altlasten, paywallCounter, prlists,
    // custom-regions, analytics-cache, vetnummern*, abopreise,
    // leaderboard_metadata, missions, userFeedbacks, fehler, appSettings,
    // produktvorschlaege, neuesGeheimnis, collectionGroup-Freigaben) ist
    // gesperrt. Admin-Tools gehören ans Admin-SDK, nicht in offene Rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
