<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
  <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <!-- Predictive Back: Übergangs-Opt-out (11.09.2026, ClickUp 86cbgtfqr).

       Ab targetSdk 36 auf einem Android-16-Gerät ruft das System
       `onBackPressed` NICHT MEHR und verschickt kein KEYCODE_BACK mehr
       (developer.android.com, Verhaltensänderungen Android 16 — wörtlich:
       „Additionally, onBackPressed is not called and KeyEvent.KEYCODE_BACK
       is not dispatched anymore"). React Native 0.79.7 hängt aber
       ausschließlich am Legacy-Pfad: `ReactActivity.onBackPressed()` →
       `emitHardwareBackPressed()` → `hardwareBackPress` → expo-routers
       `useBackButton`-Fork. Weder react-native noch react-native-screens
       registrieren einen `OnBackInvokedCallback`, und auch beim
       AndroidX-`OnBackPressedDispatcher` meldet sich nichts an (je 0 Treffer
       im installierten Stand). Folge: Der Tastendruck erreicht die App nie,
       Android führt sein Standard-Zurück aus und beendet wegen
       `launchMode="singleTask"` die Root-Activity — der Nutzer landet auf dem
       Homescreen. Betroffen waren zwei Drittel der Android-Nutzer, seit
       targetSdk 36 (Commit 0bf6a71, ausgeliefert ab versionCode 1234).

       Dieses Attribut ist ausdrücklich der von Google vorgesehene Übergang
       („temporarily opt out by setting the android:enableOnBackInvokedCallback
       attribute to false"). ES IST KEINE DAUERLÖSUNG: Google baut das Opt-out
       schrittweise ab. Der zukunftsfeste Weg ist ein react-native- bzw.
       react-native-screens-Stand, der selbst einen OnBackInvokedCallback
       registriert — bis dahin darf diese Zeile NICHT entfernt werden.

       Expos `withPredictiveBackGesture` greift hier nicht: das Plugin gibt es
       erst ab @expo/config-plugins 54 (aufgelöst ist 10.1.2), und `prebuild`
       läuft in diesem Projekt nie, weil `android/` eingecheckt ist. -->
  <application android:enableOnBackInvokedCallback="false" android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true">
    <meta-data android:name="com.google.android.geo.API_KEY" android:value="AIzaSyCq7kOMAf65qjkZbG-futbMAL9N8NOFNi4"/>
    <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-9082891656550991~6267405772" tools:replace="android:value"/>
    <meta-data android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT" android:value="true" tools:replace="android:value"/>
    <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING" android:value="false" tools:replace="android:value"/>
    <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION" android:value="false" tools:replace="android:value"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="markendetektive"/>
        <data android:scheme="markendetektivern"/>
        <data android:scheme="exp+markendetektive"/>
      </intent-filter>
      <!-- Verified App Links (Stufe 5): Einladungs-Links öffnen die App
           DIREKT aus QR-Scannern/Messengern — ohne Browser-Zwischenschritt.
           Verifikation gegen https://markendetektive-895f7.web.app/
           .well-known/assetlinks.json.
           ACHTUNG (Task 86caj5uuu): assetlinks.json enthält derzeit NUR den
           EAS-Upload-Key-SHA256. Aus dem Play-Store installierte Apps sind mit
           dem Google-App-Signing-Key re-signiert → autoVerify schlägt still
           fehl, bis der Play-App-Signing-Cert (Play Console → App-Integrität)
           ins assetlinks.json ergänzt ist. Bis dahin greift der Browser-
           Fallback (join.html) — kein User-sichtbarer Schaden, nur kein
           Direkt-Öffnen aus externem QR. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="markendetektive-895f7.web.app" android:pathPrefix="/join-list/"/>
      </intent-filter>
    </activity>
    <uses-library android:name="org.apache.http.legacy" android:required="false"/>
  </application>
</manifest>