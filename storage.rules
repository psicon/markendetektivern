rules_version = '2';
// Markendetektive — Firebase Storage rules.
//
// Katalogbilder (Produkte, Logos, Kategorien, bereinigte Varianten) sind
// öffentlich EINZELN abrufbar (die App zeigt sie ohne Anmeldung). Auflisten
// darf nur ein Admin. Clients schreiben nur in ihre eigenen Bon- und
// Produktfoto-Ordner; alles andere schreibt das Admin-SDK.
//
// Bons (cashback-uploads/) und Produktfotos (crowduploads/) sind
// personenbezogen: nur Besitzer und Admin (Custom-Claim) dürfen lesen.
// WICHTIG (03.10.2026): Regeln werden ODER-verknüpft. Die frühere
// Sammelregel `match /{allPaths=**} { allow read: if true }` galt auch für
// diese beiden Ordner und hob die Besitzer-Regel auf — jeder konnte Bons und
// Fotos ohne Anmeldung lesen UND auflisten. Eine Sammelregel muss diese
// Ordner deshalb ausdrücklich ausnehmen und darf nie `read` (= get + list)
// für alle erlauben. Firebase-Download-URLs MIT Token laufen unabhängig von
// diesen Regeln weiter.
service firebase.storage {
  match /b/{bucket}/o {
    // Cashback bon uploads — user can write + read their own bons.
    // Read access is needed so the detail screen can render the bon
    // image via getDownloadURL() — Cloud Functions still write
    // structured data via Admin SDK.
    match /cashback-uploads/{userId}/{file=**} {
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|application/pdf');
      // Review-Konsole (Web, Custom-Claim admin:true) darf Bon-Bilder sehen.
      allow read: if request.auth != null
                   && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Product-photo crowd uploads ("voller Datensatz" wizard) — user can
    // write + read their own product photos. Cloud Functions process the
    // structured data via Admin SDK.
    match /crowduploads/{userId}/{file=**} {
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // Review-Konsole (Web, Custom-Claim admin:true) darf Produktfotos sehen.
      allow read: if request.auth != null
                   && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Profilbild der App (app/edit-profile.tsx: putFile auf
    // profilePictures/{uid}). Die Sammelregel verbot schon seit dem ersten
    // Stand dieser Datei (30.04.2026) jedes Client-Schreiben, der Upload
    // scheiterte also schon vor der Speicher-Schließung. Repariert 03.10.2026
    // (Entscheidung Patrick): nur das eigene Bild, nur Bilddateien, < 5 MB.
    // Lesen bleibt einzeln öffentlich (Sammelregel unten) — der gespeicherte
    // Link lädt so auch, nachdem optimizeImage das Bild ohne Token neu schreibt.
    match /profilePictures/{userId} {
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    // Alles andere (Katalog): einzeln abrufbar für alle, Auflisten nur
    // Admin, kein Client-Schreiben. Bons und Produktfotos sind ausgenommen —
    // für sie gelten nur die Regeln oben.
    match /{datei} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
    match /{ordner}/{rest=**} {
      allow get: if !(ordner in ['cashback-uploads', 'crowduploads']);
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
  }
}
